# HEAP_POISONING_DISABLED/LIGHT/COMPREHENSIVE are one Kconfig choice: unset the others so a user's DISABLED=y cannot win
# CONFIG_HEAP_POISONING_DISABLED is not set
# CONFIG_HEAP_POISONING_LIGHT is not set
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
# FREERTOS_CHECK_STACKOVERFLOW_NONE/PTRVAL/CANARY are one Kconfig choice: unset the others so a user's choice cannot win
# CONFIG_FREERTOS_CHECK_STACKOVERFLOW_NONE is not set
# CONFIG_FREERTOS_CHECK_STACKOVERFLOW_PTRVAL is not set
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_HEAP_USE_HOOKS=y
